{
  "name": "@vislex/editor",
  "version": "0.0.1",
  "private": true,
  "description": "vislex rich text editor (Lexical 0.52 + React 19, Vanilla Extract styles)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static.ts",
    "./styles": "./src/styles.ts",
    "./style.css": "./dist/editor.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@excalidraw/excalidraw": "0.18.1",
    "@lexical/history": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@uiw/codemirror-extensions-langs": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vanilla-extract/css": "^1.21.2",
    "@vislex/headless": "workspace:*",
    "@vislex/litexml": "workspace:*",
    "@vislex/style-token": "workspace:*",
    "@vislex/ui": "workspace:*",
    "beautiful-mermaid": "^1.1.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.21",
    "lexical": "0.52.0",
    "lucide-react": "^1.54.0",
    "mermaid": "^12.2.0",
    "shiki": "^4.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./static": {
        "import": "./dist/static.mjs",
        "types": "./dist/static.d.ts"
      },
      "./styles": {
        "import": "./dist/styles.mjs",
        "types": "./dist/styles.d.ts"
      },
      "./style.css": "./dist/editor.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
