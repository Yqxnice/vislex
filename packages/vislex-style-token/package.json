{
  "name": "@vislex/style-token",
  "version": "0.0.1",
  "private": true,
  "description": "Style tokens and CSS variables for vislex editor",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./styles": {
        "import": "./dist/styles.mjs",
        "types": "./dist/styles.d.ts"
      },
      "./style.css": "./dist/style-token.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
