{
  "name": "@vislex/renderer-video",
  "version": "0.0.1",
  "private": true,
  "description": "Video block renderer for vislex",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./dist/renderer-video.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vislex/editor": "workspace:*",
    "@vislex/renderer": "workspace:*",
    "@vislex/style-token": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./style.css": "./dist/renderer-video.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
