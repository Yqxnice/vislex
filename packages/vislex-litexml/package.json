{
  "name": "@vislex/litexml",
  "version": "0.0.1",
  "private": true,
  "description": "vislex LiteXML pure JSON↔XML bridge (zero React, zero DOM, browser & Node)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lexical": "0.52.0"
  },
  "devDependencies": {
    "lexical": "0.52.0",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
